import os
from fastapi import FastAPI, HTTPException
from fastapi.middleware.cors import CORSMiddleware
from fastapi.staticfiles import StaticFiles
from pydantic import BaseModel
import yt_dlp
from moviepy.editor import VideoFileClip

app = FastAPI()

# Enable CORS for frontend communication
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_methods=["*"],
    allow_headers=["*"],
)

os.makedirs("downloads", exist_ok=True)
os.makedirs("shorts", exist_ok=True)
app.mount("/shorts", StaticFiles(directory="shorts"), name="shorts")

class VideoRequest(BaseModel):
    url: str
    start_time: int = 10  # Default start (can be replaced by AI timestamp selection)
    end_time: int = 40    # Default end

def download_youtube_video(url: str, output_path: str):
    ydl_opts = {
        'format': 'bestvideo[ext=mp4]+bestaudio[ext=m4a]/mp4',
        'outtmpl': output_path,
        'quiet': True
    }
    with yt_dlp.YoutubeDL(ydl_opts) as ydl:
        ydl.download([url])

def convert_to_vertical_short(input_path: str, output_path: str, start: int, end: int):
    # Load video and trim
    clip = VideoFileClip(input_path).subclip(start, end)
    
    # Calculate 9:16 vertical crop dimensions from center
    w, h = clip.size
    target_ratio = 9 / 16
    new_w = int(h * target_ratio)
    
    # Crop center
    cropped_clip = clip.crop(x_center=w/2, y_center=h/2, width=new_w, height=h)
    
    # Write output
    cropped_clip.write_videofile(output_path, codec="libx264", audio_codec="aac", logger=None)
    clip.close()

@app.post("/generate-short")
async def generate_short(req: VideoRequest):
    try:
        raw_video = "downloads/temp_video.mp4"
        output_short = "shorts/short_clip.mp4"
        
        # Remove old files if they exist
        if os.path.exists(raw_video): os.remove(raw_video)
        if os.path.exists(output_short): os.remove(output_short)

        # 1. Download Video
        download_youtube_video(req.url, raw_video)
        
        # 2. Cut and Crop to 9:16
        convert_to_vertical_short(raw_video, output_short, req.start_time, req.end_time)
        
        return {"status": "success", "video_url": "http://localhost:8000/shorts/short_clip.mp4"}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

